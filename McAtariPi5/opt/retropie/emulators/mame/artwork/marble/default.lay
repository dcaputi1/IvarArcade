<?xml version="1.0"?>
<!--
  ini/marble.ini opens a second output and selects this view for it (view1),
  so MAME itself draws the panel on the spare monitor instead of dmarquees.
  panel-marble.png is rendered from images/mcpanel-1-labels.svg at 1600x728,
  preserving the source aspect ratio and centered in the 1600x1200 view.
-->
<mamelayout version="2">
	<element name="black">
		<rect><color red="0" green="0" blue="0" /></rect>
	</element>
	<element name="panel">
		<image file="panel-marble.png" />
	</element>

	<view name="Dual Spinners">
		<bounds x="0" y="0" width="1600" height="1200" />
		<element ref="black"><bounds x="0" y="0" width="1600" height="1200" /></element>
		<element ref="panel"><bounds x="0" y="236" width="1600" height="728" /></element>
	</view>
</mamelayout>
